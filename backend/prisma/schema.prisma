generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STAFF
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  issuedQRs    QRCode[] @relation("IssuedQR")
  claimedQRs   QRCode[] @relation("ClaimedQR")

  transactions Transaction[]
  histories    TransactionHistory[]
  ledgerEntries LedgerEntry[]
  auditLogs    AuditLog[]
  redemptions RewardRedemption[]
}

enum QRStatus {
  ISSUED
  CLAIMED
  EXPIRED
  INVALIDATED
}

enum TransactionStatus {
  CLAIMED
  APPROVED
  REJECTED
  POSTED
}

enum RewardRedemptionStatus {
  REDEEMED
  CANCELLED
}
model QRCode {
  id            String   @id @default(uuid())
  nonce         String   @unique
  signature     String
  payload       Json
  status        QRStatus @default(ISSUED)
  expiresAt     DateTime

  issuedBy      String
  claimedBy     String?
  invalidatedBy String?

  claimedAt     DateTime?
  invalidatedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  issuer        User     @relation("IssuedQR", fields: [issuedBy], references: [id])
  claimant      User?    @relation("ClaimedQR", fields: [claimedBy], references: [id])
  transaction   Transaction?
}

model Transaction {
  id                String            @id @default(uuid())
  userId            String
  qrId              String            @unique
  status            TransactionStatus @default(CLAIMED)
  materialType      String?
  estimatedWeightKg Float?
  points            Int               @default(0)
  rejectionReason   String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id])
  qr                QRCode            @relation(fields: [qrId], references: [id])
  history           TransactionHistory[]
  ledgerEntries     LedgerEntry[]
}

model TransactionHistory {
  id            String   @id @default(uuid())
  transactionId String
  fromStatus    String?
  toStatus      String
  changedBy     String
  remarks       String?
  createdAt     DateTime @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id])
  user          User        @relation(fields: [changedBy], references: [id])
}

model LedgerEntry {
  id            String   @id @default(uuid())
  userId        String
  transactionId String?
  points        Int
  type          String
  description   String?
  createdAt     DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  userId        String?
  qrId          String?
  transactionId String?
  details       Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id])
}

model RewardRate {
  id            String   @id @default(uuid())
  materialType  String   @unique
  pointsPerKg   Int
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Reward {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  pointsRequired Int
  stock          Int      @default(0)
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redemptions    RewardRedemption[]
}

model RewardRedemption {
  id          String   @id @default(uuid())
  userId      String
  rewardId    String
  pointsUsed  Int
  status RewardRedemptionStatus @default(REDEEMED)
  remarks     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  reward      Reward   @relation(fields: [rewardId], references: [id])
}
