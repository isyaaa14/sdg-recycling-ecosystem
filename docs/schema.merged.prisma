// Merged schema: live backend (dev) models + student-3's QR/transaction/reward
// modules, reconciled per backend/student3-review.md recommendations.
//
// Changes from a naive merge:
// - Role stays STUDENT/ADMIN (no STAFF added, per review's "do not add STAFF
//   first unless team really need it").
// - `Transaction` renamed to `RecyclingTransaction` to avoid a generic name
//   clashing with future models, per review's naming suggestion.
// - No `LedgerEntry` model: `PointsEvent` stays the single source of truth for
//   point balance, extended with optional links to the new tables.
// - `RewardRedemptionStatus` has a RESERVED step before COMPLETED/CANCELLED,
//   instead of student-3's direct REDEEMED, per review's "reserve points
//   first" recommendation.
// - `PointsEventType` extended with QR/reward event types.
//
// This file is for local testing only (see docs/TEST_MERGED_SCHEMA.md) and is
// not wired into backend/prisma — the live schema is untouched.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/merged-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum MissionType {
  QUANTITY_BASED
  STREAK_BASED
  TIME_LIMITED
}

enum MissionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SubmissionStatus {
  ONGOING
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
}

enum BadgeCriteriaType {
  MISSIONS_COMPLETED
  QUIZZES_PASSED
  CONTENT_COMPLETED
  APPROVED_SUBMISSIONS
  // Deprecated. Kept for existing dev database rows until they are reseeded/migrated away.
  ACTIVITY_METRIC
}

enum PointsEventStatus {
  PENDING
  SENT
  FAILED
}

enum PointsEventType {
  MISSION_APPROVED
  MISSION_COMPLETED
  QR_RECYCLING_APPROVED
  REWARD_RESERVED
  REWARD_CANCELLED
}

enum UploadPurpose {
  MISSION_PROOF
  CONTENT_IMAGE
  MISSION_IMAGE
}

enum QRStatus {
  ISSUED
  CLAIMED
  EXPIRED
  INVALIDATED
}

enum RecyclingTransactionStatus {
  CLAIMED
  APPROVED
  REJECTED
  POSTED
}

enum RewardRedemptionStatus {
  RESERVED
  COMPLETED
  CANCELLED
}

model User {
  id               String               @id
  name             String
  email            String               @unique
  passwordHash     String
  role             Role                 @default(STUDENT)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  submissions      MissionSubmission[]
  reviewedItems    MissionSubmission[]  @relation("SubmissionReviewer")
  contentCreated   Content[]            @relation("ContentCreator")
  missionCreated   Mission[]            @relation("MissionCreator")
  quizAttempts     QuizAttempt[]
  badgeAwards      BadgeAward[]
  progressRecords  LearningProgress[]
  pointsEvents     PointsEvent[]
  uploads          UploadedFile[]

  issuedQRs             QRCode[]             @relation("IssuedQR")
  claimedQRs            QRCode[]             @relation("ClaimedQR")
  recyclingTransactions RecyclingTransaction[]
  transactionHistoryChanges TransactionHistory[]
  auditLogs             AuditLog[]
  rewardRedemptions     RewardRedemption[]
}

model Mission {
  id             String               @id
  slug           String               @unique
  title          String
  description    String
  longDescription String?
  imageUrl       String?
  guide          Json?
  targetQuantity Int?
  targetDays     Int?
  type           MissionType
  startAt        DateTime
  endAt          DateTime
  submissionCap  Int?
  points         Int
  autoApprove    Boolean              @default(false)
  isActive       Boolean              @default(true)
  status         MissionStatus        @default(DRAFT)
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdBy      User                 @relation("MissionCreator", fields: [createdById], references: [id])
  submissions    MissionSubmission[]
  pointsEvents   PointsEvent[]

  @@index([status, startAt, endAt])
  @@index([isActive])
}

model MissionSubmission {
  id            String            @id
  missionId     String
  userId        String
  proofText     String?
  proofImageUrl String?
  quantity      Int?
  status        SubmissionStatus  @default(PENDING_REVIEW)
  reviewNote    String?
  reviewedById  String?
  submittedAt   DateTime          @default(now())
  reviewedAt    DateTime?
  mission       Mission           @relation(fields: [missionId], references: [id])
  user          User              @relation(fields: [userId], references: [id])
  reviewedBy    User?             @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
  pointsEvents  PointsEvent[]
  uploads       UploadedFile[]

  @@index([missionId, userId, submittedAt])
  @@index([status, submittedAt])
}

model PointsEvent {
  id                    String               @id
  userId                String
  missionId             String?
  // For MISSION_COMPLETED, this is the final approved submission
  // that caused the mission to reach its completion target.
  submissionId          String?
  recyclingTransactionId String?
  rewardRedemptionId    String?
  points                Int
  eventType             PointsEventType
  status                PointsEventStatus    @default(PENDING)
  approvedAt            DateTime
  lastAttemptAt         DateTime?
  errorMessage          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id])
  mission               Mission?             @relation(fields: [missionId], references: [id])
  submission            MissionSubmission?   @relation(fields: [submissionId], references: [id])
  recyclingTransaction  RecyclingTransaction? @relation(fields: [recyclingTransactionId], references: [id])
  rewardRedemption      RewardRedemption?    @relation(fields: [rewardRedemptionId], references: [id])

  @@index([status, createdAt])
}

model Content {
  id              String             @id
  slug            String             @unique
  title           String
  body            String
  summary         String?
  imageUrl        String?
  estimatedReadMinutes Int           @default(5)
  contentBlocks   Json?
  tags            String[]
  status          ContentStatus      @default(DRAFT)
  version         Int                @default(1)
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdBy       User               @relation("ContentCreator", fields: [createdById], references: [id])
  quizzes         Quiz[]
  revisions       ContentRevision[]
  progressRecords LearningProgress[]
}

model ContentRevision {
  id          String   @id
  contentId   String
  version     Int
  title       String
  body        String
  summary     String?
  imageUrl    String?
  estimatedReadMinutes Int?
  contentBlocks Json?
  tags        String[]
  status      ContentStatus
  createdAt   DateTime @default(now())
  content     Content  @relation(fields: [contentId], references: [id])

  @@index([contentId, version])
}

model Quiz {
  id             String        @id
  contentId      String
  slug           String        @unique
  title          String
  passingScore   Int           @default(4)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  content        Content       @relation(fields: [contentId], references: [id])
  questions      QuizQuestion[]
  attempts       QuizAttempt[]
}

model QuizQuestion {
  id            String   @id
  quizId        String
  code          String   @unique
  questionText  String
  options       String[]
  correctAnswer String
  points        Int      @default(1)
  quiz          Quiz     @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id             String   @id
  quizId         String
  userId         String
  score          Int
  totalQuestions Int
  correctAnswers Int
  passed         Boolean
  answers        Json
  timeSpentSeconds Int?
  attemptedAt    DateTime @default(now())
  quiz           Quiz     @relation(fields: [quizId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, attemptedAt])
}

model Badge {
  id                  String             @id
  slug                String             @unique
  name                String
  description         String
  tier                BadgeTier
  criteriaType        BadgeCriteriaType
  criteriaValue       Int
  criteriaReferenceId String?
  criteriaReference   String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  awards              BadgeAward[]
}

model BadgeAward {
  id         String   @id
  userId     String
  badgeId    String
  awardedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  badge      Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId, awardedAt])
}

model LearningProgress {
  id                  String   @id
  userId              String
  contentId           String
  completed           Boolean  @default(false)
  completionCount     Int      @default(0)
  quizAttemptsCount   Int      @default(0)
  passedQuizCount     Int      @default(0)
  latestScore         Int?
  bestScore           Int?
  lastActivityAt      DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id])
  content             Content  @relation(fields: [contentId], references: [id])

  @@unique([userId, contentId])
  @@index([userId, lastActivityAt])
}

model UploadedFile {
  id                  String           @id
  userId              String
  missionSubmissionId String?
  containerName       String
  blobName            String
  fileUrl             String
  mimeType            String
  fileSize            Int
  purpose             UploadPurpose
  createdAt           DateTime         @default(now())
  user                User             @relation(fields: [userId], references: [id])
  missionSubmission   MissionSubmission? @relation(fields: [missionSubmissionId], references: [id])
}

// ---- Merged in from student-3's QR / recycling / reward modules ----

model QRCode {
  id            String   @id @default(uuid())
  nonce         String   @unique
  signature     String
  payload       Json
  status        QRStatus @default(ISSUED)
  expiresAt     DateTime

  issuedBy      String
  claimedBy     String?
  invalidatedBy String?

  claimedAt     DateTime?
  invalidatedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  issuer        User               @relation("IssuedQR", fields: [issuedBy], references: [id])
  claimant      User?              @relation("ClaimedQR", fields: [claimedBy], references: [id])
  transaction   RecyclingTransaction?
}

model RecyclingTransaction {
  id                String                     @id @default(uuid())
  userId            String
  qrId              String                     @unique
  status            RecyclingTransactionStatus @default(CLAIMED)
  materialType      String?
  estimatedWeightKg Float?
  points            Int                        @default(0)
  rejectionReason   String?

  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  qr                QRCode        @relation(fields: [qrId], references: [id])
  history           TransactionHistory[]
  pointsEvents      PointsEvent[]
}

model TransactionHistory {
  id            String   @id @default(uuid())
  transactionId String
  fromStatus    String?
  toStatus      String
  changedBy     String
  remarks       String?
  createdAt     DateTime @default(now())

  transaction   RecyclingTransaction @relation(fields: [transactionId], references: [id])
  user          User                 @relation(fields: [changedBy], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  userId        String?
  qrId          String?
  transactionId String?
  details       Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id])
}

model RewardRate {
  id            String   @id @default(uuid())
  materialType  String   @unique
  pointsPerKg   Int
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Reward {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  pointsRequired Int
  stock          Int      @default(0)
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redemptions    RewardRedemption[]
}

model RewardRedemption {
  id          String                  @id @default(uuid())
  userId      String
  rewardId    String
  pointsUsed  Int
  status      RewardRedemptionStatus  @default(RESERVED)
  remarks     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  reward        Reward        @relation(fields: [rewardId], references: [id])
  pointsEvents  PointsEvent[]
}
